@model List<AnimalNetwork.Models.Entities.Message>

@{
    ViewData["Title"] = "Conversation";
}

<h2>Chat</h2>

<form asp-action="Send" method="post">
    <div class="form-group">
        <label for="content">Message</label>
        <input type="text" name="content" class="form-control" placeholder="Type your message..." />
    </div>
    <input type="hidden" name="receiverId" value="@ViewBag.OtherUser.Id" />
    <button type="submit" class="btn btn-primary mt-2">Send</button>
</form>

<ul class="mt-3 list-unstyled">
    @foreach (var msg in Model)
    {
        <li>
            <strong>@(msg.SenderId == ViewBag.OtherUser.Id ? ViewBag.OtherUser.Username : "You"):</strong>
            @msg.Content
            <small class="text-muted">(@msg.SentAt.ToShortTimeString())</small>
        </li>
    }
</ul>
